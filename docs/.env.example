# Athlete OS — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ─────────────────────────────────────────
# STRAVA (required)
# Get these from https://www.strava.com/settings/api
# ─────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# ─────────────────────────────────────────
# SLACK (optional — for /athlete-notify)
# Get from https://api.slack.com/apps → Incoming Webhooks
# ─────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─────────────────────────────────────────
# TELEGRAM (optional — for /athlete-notify)
# Get token from @BotFather, chat ID from getUpdates API
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────
# EMAIL (optional — for email summaries)
# ─────────────────────────────────────────
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
