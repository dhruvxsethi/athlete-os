# Athlete OS — Cloud Routine Environment Variables
#
# These variables are ONLY needed when running Athlete OS as a scheduled
# cloud routine (claude.ai → Routines → Environment variables).
#
# For normal local use, credentials are stored in:
#   ~/.config/athlete-os/credentials.json
# Run "Connect my Strava account" to set those up.
#
# Never commit actual values to version control.

# ─────────────────────────────────────────
# STRAVA (required for cloud routines)
# Get token via: "Connect my Strava account" → credentials.json
# ─────────────────────────────────────────
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=

# ─────────────────────────────────────────
# TELEGRAM (optional — for push notifications)
# Get token from @BotFather, chat ID from @userinfobot
# Run "Connect Telegram" to set up locally first
# ─────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─────────────────────────────────────────
# OURA (optional — for recovery/HRV data)
# Get from cloud.ouraring.com/personal-access-tokens
# Run "Connect my Oura Ring" to set up locally first
# ─────────────────────────────────────────
OURA_ACCESS_TOKEN=
